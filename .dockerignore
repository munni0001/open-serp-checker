# Build context exclusions — mirrors .gitignore for the subset that matters at build time.
.git
.gitignore
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
.ruff_cache/
venv/
.venv/
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
sessions/
articles/
scripts/probes/logs/
notes/
tests/
.DS_Store
.idea/
.vscode/
.claude/
.github/
Dockerfile
docker-compose.yml
