# App
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=open_serp_checker.db

# Fallback proxy URL used only when neither the keyword's proxy_id nor its
# project's default_proxy_id is set. Configure proxies via /proxies in the
# dashboard for anything you want to test or reassign at runtime.
# SERP_PROXY_URL=http://user:pass@host:port

# -- SERP provider API keys (all optional) -----------------------------------
# Bing works without any configuration. Google works via a proxy.
# The three below unlock the SearXNG / DataForSEO / Serper engines.

# SearXNG — URL of a self-hosted or private instance. Public instances
# universally rate-limit the JSON API, so you need your own:
#   docker run -p 8080:8080 searxng/searxng
# SEARXNG_URL=http://localhost:8080

# DataForSEO — sign up at https://dataforseo.com. Paid, parsed JSON, no captcha.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# Serper — sign up at https://serper.dev. Paid, cheaper alternative at low volume.
# SERPER_API_KEY=

# WARNING: Proxy credentials entered via the dashboard are stored plaintext in
# the SQLite DB. open-serp-checker is designed for LOCAL SINGLE-USER use only.
# Do not expose port 8000 publicly. open_serp_checker.db is gitignored by default.
