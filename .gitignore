# Markdown docs
*.md

# Environment files
.env
.env.*
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.venv/
venv/

# Databases
*.db
*.sqlite
*.sqlite3

# Probe run outputs (raw HTML sizes, IPs, timestamps — reproducible, not source)
scripts/probes/logs/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
.claude/

# Testing / misc
test_*.py
verify_*.py
.pytest_cache/
.coverage

# Exception: keep the proper tests directory tracked (overrides *.md and test_*.py above)
!tests/
!tests/**
# ...but keep Python caches out of tests/ too
tests/**/__pycache__/
tests/**/*.py[cod]

# Exception: user-facing OSS docs that ship with the repo
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/docs/
!/docs/**
!/.github/
!/.github/**